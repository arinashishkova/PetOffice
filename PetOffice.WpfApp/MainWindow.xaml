<Window x:Class="PetOffice.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pet Office"
        Height="650"
        Width="900"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE -->
        <StackPanel Grid.Column="0">

            <TextBlock Text="Pet Office"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Add office pet"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Type:"/>

            <ComboBox x:Name="PetTypeComboBox"
                      Height="32"
                      Margin="0,5,0,12"/>

            <TextBlock Text="Name:"/>

            <TextBox x:Name="NameTextBox"
                     Height="32"
                     Margin="0,5,0,12"/>

            <Button x:Name="AddButton"
                    Content="Add pet"
                    Height="36"
                    Click="AddButton_Click"/>

            <Separator Margin="0,22,0,18"/>

            <!-- SELECTED PET -->
            <TextBlock Text="Selected pet"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="SelectedPetTextBlock"
                       Text="No pet selected"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>

            <!-- ENERGY -->
            <TextBlock Text="Energy:"/>

            <ProgressBar x:Name="EnergyProgressBar"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Height="22"
                         Margin="0,5,0,4"/>

            <TextBlock x:Name="EnergyTextBlock"
                       Text="0 / 100"
                       Margin="0,0,0,12"/>

            <!-- TASKS -->
            <TextBlock x:Name="TasksTextBlock"
                       Text="Tasks completed: 0"
                       Margin="0,0,0,18"/>

            <Button x:Name="RemoveButton"
                    Content="Remove pet"
                    Height="34"
                    Click="RemoveButton_Click"/>

        </StackPanel>

        <!-- RIGHT SIDE -->
        <Grid Grid.Column="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="220"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- PET LIST -->
            <Grid Grid.Row="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Office pets"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <ListBox x:Name="PetsListBox"
                         Grid.Row="1"
                          DisplayMemberPath="DisplayName"
         SelectionChanged="PetsListBox_SelectionChanged"/>

            </Grid>

            <!-- MAIN ACTIONS -->
            <StackPanel Grid.Row="1"
                        Margin="0,18,0,0">

                <TextBlock Text="Actions"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="WorkButton"
                            Grid.Column="0"
                            Content="Work"
                            Height="36"
                            Margin="0,0,5,0"
                            Click="WorkButton_Click"/>

                    <Button x:Name="CrazyButton"
                            Grid.Column="1"
                            Content="Crazy Action"
                            Height="36"
                            Margin="5,0,0,0"
                            Click="CrazyButton_Click"/>

                </Grid>

            </StackPanel>

            <!-- ABILITY BUTTONS -->
            <StackPanel Grid.Row="2"
                        Margin="0,15,0,18">

                <TextBlock Text="Abilities"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CommunicateButton"
                            Grid.Column="0"
                            Content="Communicate"
                            Height="36"
                            Margin="0,0,5,0"
                            Click="CommunicateButton_Click"/>

                    <Button x:Name="CoffeeButton"
                            Grid.Column="1"
                            Content="Make coffee"
                            Height="36"
                            Margin="5,0,5,0"
                            Click="CoffeeButton_Click"/>

                    <Button x:Name="FixButton"
                            Grid.Column="2"
                            Content="Fix computer"
                            Height="36"
                            Margin="5,0,0,0"
                            Click="FixButton_Click"/>

                </Grid>

            </StackPanel>

            <!-- LOG -->
            <Grid Grid.Row="3">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Activity log"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <ListBox x:Name="LogListBox"
                         Grid.Row="1"/>

            </Grid>

        </Grid>

    </Grid>

</Window>