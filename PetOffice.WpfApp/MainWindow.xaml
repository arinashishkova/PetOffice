<Window x:Class="PetOffice.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PetOffice.WpfApp.Views"
        Title="Pet Office"
        Height="820"
        Width="1050"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F8F6F4"
        Icon="Assets/petoffice_icon.ico">

    <Window.Resources>

        <!-- Rounded tab button -->
        <Style x:Key="RoundedTabItemStyle"
               TargetType="TabItem">

            <Setter Property="Foreground"
                    Value="#667085"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Background"
                    Value="#F2F4F7"/>

            <Setter Property="BorderBrush"
                    Value="#E0E4E8"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TabItem">

                        <!--
                        Spacing is inside the template,
                        so TabPanel does not cut the corners.
                        -->
                        <Grid Margin="4,3,4,3">

                            <Border x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="18,9">

                                <ContentPresenter
                                    ContentSource="Header"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#ECEFF3"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#E2DDF5"/>

                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="#CEC5EA"/>

                                <Setter Property="Foreground"
                                        Value="#4F4775"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- Main tab container -->
        <Style x:Key="RoundedTabControlStyle"
               TargetType="TabControl">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TabControl">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Tab buttons -->
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Background="Transparent"/>


                            <!-- Selected page -->
                            <Border Grid.Row="2"
                                    Background="#FFFDFC"
                                    BorderBrush="#DFE3E6"
                                    BorderThickness="1"
                                    CornerRadius="14">

                                <ContentPresenter
                                    ContentSource="SelectedContent"/>

                            </Border>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid Margin="12">

        <TabControl
            Style="{StaticResource RoundedTabControlStyle}">

            <TabItem
                Header="Pet Office"
                Style="{StaticResource RoundedTabItemStyle}">

                <views:PetOfficePanel/>

            </TabItem>


            <TabItem
                Header="CPU Analysis"
                Style="{StaticResource RoundedTabItemStyle}">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <views:AnalysisPanel Margin="18"/>

                </ScrollViewer>

            </TabItem>

        </TabControl>

    </Grid>

</Window>