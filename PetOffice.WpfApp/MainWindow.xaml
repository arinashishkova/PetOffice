<Window x:Class="PetOffice.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PetOffice.WpfApp.Views"
        Title="Pet Office"
        Height="820"
        Width="1050"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F8F6F4"
        Icon="Assets/petoffice_icon.ico">

    <Window.Resources>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#59666D"/>
            <Setter Property="Padding" Value="18,9"/>
        </Style>

    </Window.Resources>

    <Grid Margin="18">

        <TabControl Background="#F8F6F4"
                    BorderBrush="#DFE3E6"
                    BorderThickness="1">

            <TabItem Header="Pet Office">
                <views:PetOfficePanel/>
            </TabItem>

            <TabItem Header="CPU Analysis">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <views:AnalysisPanel Margin="18"/>

                </ScrollViewer>

            </TabItem>

        </TabControl>

    </Grid>

</Window>
