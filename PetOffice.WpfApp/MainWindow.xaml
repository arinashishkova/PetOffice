<Window x:Class="PetOffice.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PetOffice.WpfApp.Views"

        Title="Pet Office"
        Width="1180"
        SizeToContent="Height"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"

        Background="{StaticResource AppWindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"

        Icon="Assets/petoffice_icon.ico">


    <Grid Margin="12">

        <TabControl
            Style="{StaticResource RoundedTabControlStyle}">


            <!-- PET OFFICE -->
            <TabItem
                Header="Pet Office"
                Style="{StaticResource RoundedTabItemStyle}">

                <views:PetOfficePanel/>

            </TabItem>


            <!-- CPU ANALYSIS -->
            <TabItem
                Header="CPU Analysis"
                Style="{StaticResource RoundedTabItemStyle}">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <views:AnalysisPanel Margin="18"/>

                </ScrollViewer>

            </TabItem>


            <!-- STORAGE -->
            <TabItem
                Header="Storage"
                Style="{StaticResource RoundedTabItemStyle}">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <views:StoragePanel Margin="18"/>

                </ScrollViewer>

            </TabItem>


        </TabControl>

    </Grid>

</Window>