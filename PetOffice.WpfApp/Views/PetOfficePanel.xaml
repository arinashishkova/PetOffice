<UserControl x:Class="PetOffice.WpfApp.Views.PetOfficePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PetOffice.WpfApp.Views">

    <UserControl.Resources>

        <!-- GENERAL CARD -->
        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="BorderBrush"
                    Value="#DFE3E6"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="20"/>

        </Style>


        <!-- INPUT -->
        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Padding"
                    Value="9,5"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <Style x:Key="InputComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Padding"
                    Value="7,4"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <!-- LOG ITEM -->
        <Style x:Key="LogListItemStyle"
               TargetType="ListBoxItem">

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="0,2"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="6,3">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#EEF8F0"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#DFF1E6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ADD BUTTON -->
        <Style x:Key="AddButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="12,6"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="Background"
                    Value="#B7D8D3"/>

            <Setter Property="BorderBrush"
                    Value="#9FC6C0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.78"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.35"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ADD CARD WATERMARK -->
        <DrawingBrush x:Key="AddWatermarkBrush"
              TileMode="Tile"
              Viewport="0,0,150,110"
              ViewportUnits="Absolute"
              Stretch="None">

            <DrawingBrush.Drawing>

                <DrawingGroup>

                    <ImageDrawing
                ImageSource="/PetOffice.WpfApp;component/Assets/add_back_watermark.png"
                Rect="14,10,24,24"/>

                    <ImageDrawing
                ImageSource="/PetOffice.WpfApp;component/Assets/add_back_watermark.png"
                Rect="88,62,24,24"/>

                </DrawingGroup>

            </DrawingBrush.Drawing>

        </DrawingBrush>


        <!-- LOG CARD WATERMARK -->
        <DrawingBrush x:Key="LogWatermarkBrush"
              TileMode="Tile"
              Viewport="0,0,165,115"
              ViewportUnits="Absolute"
              Stretch="None">

            <DrawingBrush.Drawing>

                <DrawingGroup>

                    <ImageDrawing
                ImageSource="/PetOffice.WpfApp;component/Assets/log_back_watermark.png"
                Rect="16,12,24,24"/>

                    <ImageDrawing
                ImageSource="/PetOffice.WpfApp;component/Assets/log_back_watermark.png"
                Rect="98,66,24,24"/>

                </DrawingGroup>

            </DrawingBrush.Drawing>

        </DrawingBrush>


        <!-- SAME SCROLLBAR AS PET LIST -->
        <Style x:Key="ThinScrollBarStyle"
               TargetType="ScrollBar">

            <Setter Property="Width"
                    Value="8"/>

            <Setter Property="Margin"
                    Value="7,5,2,5"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Width="8"
                              Background="Transparent">

                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   IsDirectionReversed="True"
                                   Focusable="False">

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageUpCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Opacity="0"
                                        Focusable="False"/>

                                </Track.DecreaseRepeatButton>


                                <Track.Thumb>

                                    <Thumb Width="6"
                                           MinHeight="28"
                                           Background="#B8C2CB">

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="Thumb">

                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3"/>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>


                                <Track.IncreaseRepeatButton>

                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageDownCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Opacity="0"
                                        Focusable="False"/>

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>


                        <!--
                        the scrollbar keeps its place,
                        but becomes invisible when scrolling
                        is not required
                        -->
                        <ControlTemplate.Triggers>

                            <Trigger Property="Maximum"
                                     Value="0">

                                <Setter Property="Opacity"
                                        Value="0"/>

                                <Setter Property="IsHitTestVisible"
                                        Value="False"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>


        <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Pet Office"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#344054"/>

                    <TextBlock Text="Where serious business meets paws"
                               FontSize="13"
                               Foreground="#7B8790"
                               Margin="1,4,0,0"/>

                </StackPanel>


                <!-- PET ICONS -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Image Source="/PetOffice.WpfApp;component/Assets/cat.png"
                           Width="48"
                           Height="48"
                           Margin="0,0,8,0"/>

                    <Image Source="/PetOffice.WpfApp;component/Assets/dog.png"
                           Width="48"
                           Height="48"
                           Margin="0,0,8,0"/>

                    <Image Source="/PetOffice.WpfApp;component/Assets/hamster.png"
                           Width="48"
                           Height="48"
                           Margin="0,0,8,0"/>

                    <Image Source="/PetOffice.WpfApp;component/Assets/parrot.png"
                           Width="48"
                           Height="48"
                           Margin="0,0,8,0"/>

                    <Image Source="/PetOffice.WpfApp;component/Assets/rabbit.png"
                           Width="48"
                           Height="48"
                           Margin="0,0,8,0"/>

                    <Image Source="/PetOffice.WpfApp;component/Assets/owl.png"
                           Width="48"
                           Height="48"
                           Margin="0,0,8,0"/>

                    <Image Source="/PetOffice.WpfApp;component/Assets/raccoon.png"
                           Width="48"
                           Height="48"/>

                </StackPanel>

            </Grid>


            <!-- TOP WORKSPACE -->
            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- LEFT HALF -->
                <Grid Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- ADD OFFICE PET -->
                    <Border Grid.Row="0"
                            Style="{StaticResource CardStyle}"
                            Background="#FFF4E8">

                        <Grid>

                            <!-- ADD WATERMARK -->
                            <Rectangle Fill="{StaticResource AddWatermarkBrush}"
                                       Opacity="0.035"
                                       IsHitTestVisible="False"/>


                            <!-- CONTENT -->
                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <!-- HEADER -->
                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,18">

                                    <Image Source="/PetOffice.WpfApp;component/Assets/add.png"
                                           Width="27"
                                           Height="27"
                                           Stretch="Uniform"
                                           Margin="0,0,10,0"/>

                                    <TextBlock Text="Add office pet"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#344054"
                                               VerticalAlignment="Center"/>

                                </StackPanel>


                                <!-- TYPE -->
                                <Grid Grid.Row="1"
                                      Margin="0,0,0,12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <TextBlock Text="Type"
                                               Foreground="#59666D"
                                               VerticalAlignment="Center"/>


                                    <Border Grid.Column="1"
                                            Height="38"
                                            Background="#D9FFFFFF"
                                            BorderBrush="#D7CFC7"
                                            BorderThickness="1"
                                            CornerRadius="8">

                                        <ComboBox
                                            Style="{StaticResource InputComboBoxStyle}"
                                            ItemsSource="{Binding RepositoryNames}"
                                            SelectedItem="{Binding SelectedRepository,
                                                                   Mode=TwoWay}"/>

                                    </Border>

                                </Grid>


                                <!-- NAME -->
                                <Grid Grid.Row="2"
                                      Margin="0,0,0,14">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <Image Source="/PetOffice.WpfApp;component/Assets/pet_name.png"
                                               Width="18"
                                               Height="18"
                                               Margin="0,0,6,0"/>

                                        <TextBlock Text="Name"
                                                   Foreground="#59666D"
                                                   VerticalAlignment="Center"/>

                                    </StackPanel>


                                    <Border Grid.Column="1"
                                            Height="38"
                                            Background="#D9FFFFFF"
                                            BorderBrush="#D7CFC7"
                                            BorderThickness="1"
                                            CornerRadius="8">

                                        <TextBox
                                            Style="{StaticResource InputTextBoxStyle}"
                                            Text="{Binding NewPetName,
                                                           Mode=TwoWay,
                                                           UpdateSourceTrigger=PropertyChanged}"/>

                                    </Border>

                                </Grid>


                                <!-- ADD BUTTON -->
                                <Button Grid.Row="3"
                                        Style="{StaticResource AddButtonStyle}"
                                        Command="{Binding AddCommand}">

                                    <StackPanel Orientation="Horizontal">

                                        <Image Source="/PetOffice.WpfApp;component/Assets/add.png"
                                               Width="19"
                                               Height="19"
                                               Margin="0,0,7,0"/>

                                        <TextBlock Text="Add pet"
                                                   VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Button>

                            </Grid>

                        </Grid>

                    </Border>


                    <!-- SELECTED PET -->
                    <views:PetDetailsPanel Grid.Row="2"
                                           VerticalAlignment="Stretch"/>

                </Grid>


                <!-- RIGHT HALF -->
                <views:PetListPanel Grid.Column="2"
                                    VerticalAlignment="Stretch"/>

            </Grid>


            <!-- ACTIVITY LOG -->
        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                Background="#EFF8F2"
                Margin="0,0,0,20"
                MinHeight="190">

            <Grid>

                    <!-- LOG WATERMARK -->
                    <Rectangle Fill="{StaticResource LogWatermarkBrush}"
                               Opacity="0.035"
                               IsHitTestVisible="False"/>


                    <!-- LOG CONTENT -->
                    <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,10">

                            <Image Source="/PetOffice.WpfApp;component/Assets/log.png"
                                   Width="25"
                                   Height="25"
                                   Stretch="Uniform"
                                   Margin="0,0,9,0"/>

                            <TextBlock Text="Activity log"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#344054"
                                       VerticalAlignment="Center"/>

                        </StackPanel>


                        <Border Grid.Row="1"
                                Background="#E8FFFFFF"
                                BorderBrush="#CFE0D4"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="8">

                            <ListBox ItemsSource="{Binding Log}"
                                     ItemContainerStyle="{StaticResource LogListItemStyle}"
                                     FontSize="13"
                                     Padding="4"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                <ListBox.Resources>

                                    <Style TargetType="ScrollBar"
                                           BasedOn="{StaticResource ThinScrollBarStyle}"/>

                                </ListBox.Resources>


                                <!-- MESSAGE + TIME -->
                                <ListBox.ItemTemplate>

                                    <DataTemplate>

                                        <Grid Margin="2,2">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>


                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="#4F5F58"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>


                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TimeText}"
                                                       FontSize="11"
                                                       Foreground="#9AA6A0"
                                                       Margin="18,0,5,0"
                                                       VerticalAlignment="Center"/>

                                        </Grid>

                                    </DataTemplate>

                                </ListBox.ItemTemplate>

                            </ListBox>

                        </Border>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

</UserControl>