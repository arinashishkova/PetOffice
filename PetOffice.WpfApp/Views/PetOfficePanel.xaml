<UserControl x:Class="PetOffice.WpfApp.Views.PetOfficePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PetOffice.WpfApp.Views">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Pet Office"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Text="Where serious business meets paws"
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="1,4,0,0"/>

            </StackPanel>


            <!-- PET ICONS -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Image Source="/PetOffice.WpfApp;component/Assets/cat.png"
                       Width="48"
                       Height="48"
                       Margin="0,0,8,0"/>

                <Image Source="/PetOffice.WpfApp;component/Assets/dog.png"
                       Width="48"
                       Height="48"
                       Margin="0,0,8,0"/>

                <Image Source="/PetOffice.WpfApp;component/Assets/hamster.png"
                       Width="48"
                       Height="48"
                       Margin="0,0,8,0"/>

                <Image Source="/PetOffice.WpfApp;component/Assets/parrot.png"
                       Width="48"
                       Height="48"
                       Margin="0,0,8,0"/>

                <Image Source="/PetOffice.WpfApp;component/Assets/rabbit.png"
                       Width="48"
                       Height="48"
                       Margin="0,0,8,0"/>

                <Image Source="/PetOffice.WpfApp;component/Assets/owl.png"
                       Width="48"
                       Height="48"
                       Margin="0,0,8,0"/>

                <Image Source="/PetOffice.WpfApp;component/Assets/raccoon.png"
                       Width="48"
                       Height="48"/>

            </StackPanel>

        </Grid>


        <!-- =====================================================
             TOP WORKSPACE
             ===================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- =================================================
                 LEFT HALF
                 ================================================= -->

            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- =============================================
                     ADD OFFICE PET
                     ============================================= -->

                <Border Grid.Row="0"
                        Style="{StaticResource CardStyle}"
                        Background="{StaticResource AddCardBrush}">

                    <Grid>

                        <!-- BACKGROUND PATTERN -->
                        <Rectangle Fill="{StaticResource AddWatermarkBrush}"
                                   IsHitTestVisible="False"/>


                        <!-- CONTENT -->
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <!-- HEADER -->
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,18">

                                <Image Source="/PetOffice.WpfApp;component/Assets/add.png"
                                       Width="27"
                                       Height="27"
                                       Stretch="Uniform"
                                       Margin="0,0,10,0"/>

                                <TextBlock Text="Add office pet"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>

                            </StackPanel>


                            <!-- TYPE -->
                            <Grid Grid.Row="1"
                                  Margin="0,0,0,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Type"
                                           Foreground="#59666D"
                                           VerticalAlignment="Center"/>


                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          ItemsSource="{Binding RepositoryNames}"
                                          SelectedItem="{Binding SelectedRepository,
                                                                 Mode=TwoWay}"/>

                            </Grid>


                            <!-- NAME -->
                            <Grid Grid.Row="2"
                                  Margin="0,0,0,14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <Image Source="/PetOffice.WpfApp;component/Assets/pet_name.png"
                                           Width="18"
                                           Height="18"
                                           Margin="0,0,6,0"/>

                                    <TextBlock Text="Name"
                                               Foreground="#59666D"
                                               VerticalAlignment="Center"/>

                                </StackPanel>


                                <Border Grid.Column="1"
                                        Height="38"
                                        Background="#D9FFFFFF"
                                        BorderBrush="{StaticResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding NewPetName,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"/>

                                </Border>

                            </Grid>


                            <!-- ADD BUTTON -->
                            <Button Grid.Row="3"
                                    Style="{StaticResource AddButtonStyle}"
                                    Command="{Binding AddCommand}">

                                <StackPanel Orientation="Horizontal">

                                    <Image Source="/PetOffice.WpfApp;component/Assets/add.png"
                                           Width="19"
                                           Height="19"
                                           Margin="0,0,7,0"/>

                                    <TextBlock Text="Add pet"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                    </Grid>

                </Border>


                <!-- =============================================
                     SELECTED PET
                     ============================================= -->

                <views:PetDetailsPanel Grid.Row="2"
                                       VerticalAlignment="Stretch"/>

            </Grid>


            <!-- =================================================
                 RIGHT HALF
                 ================================================= -->

            <views:PetListPanel Grid.Column="2"
                                VerticalAlignment="Stretch"/>

        </Grid>


        <!-- =====================================================
             ACTIVITY LOG
             ===================================================== -->

        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                Background="{StaticResource LogCardBrush}"
                Margin="0,0,0,20"
                MinHeight="190">

            <Grid>

                <!-- BACKGROUND PATTERN -->
                <Rectangle Fill="{StaticResource LogWatermarkBrush}"
                           IsHitTestVisible="False"/>


                <!-- CONTENT -->
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- HEADER -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <Image Source="/PetOffice.WpfApp;component/Assets/log.png"
                               Width="25"
                               Height="25"
                               Stretch="Uniform"
                               Margin="0,0,9,0"/>

                        <TextBlock Text="Activity log"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                    </StackPanel>


                    <!-- LOG LIST -->
                    <Border Grid.Row="1"
                            Background="#E8FFFFFF"
                            BorderBrush="#CFE0D4"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="8">

                        <ListBox ItemsSource="{Binding Log}"
                                 ItemContainerStyle="{StaticResource LogListItemStyle}"
                                 FontSize="13"
                                 Padding="4"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListBox.Resources>

                                <Style TargetType="ScrollBar"
                                       BasedOn="{StaticResource ThinScrollBarStyle}"/>

                            </ListBox.Resources>


                            <!-- MESSAGE + TIME -->
                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <Grid Margin="2,2">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>


                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="#4F5F58"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>


                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TimeText}"
                                                   FontSize="11"
                                                   Foreground="#9AA6A0"
                                                   Margin="18,0,5,0"
                                                   VerticalAlignment="Center"/>

                                    </Grid>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>