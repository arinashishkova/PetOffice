<UserControl x:Class="PetOffice.WpfApp.Views.PetOfficePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DFE3E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.78"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.35"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EnergyProgressBarStyle"
               TargetType="ProgressBar">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#E7E3EA"/>
            <Setter Property="Foreground" Value="#F3B978"/>
        </Style>

        <Style x:Key="AddButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#B7D8D3"/>
            <Setter Property="BorderBrush" Value="#9FC6C0"/>
        </Style>

        <Style x:Key="WorkButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#D7EAF7"/>
            <Setter Property="BorderBrush" Value="#BDD9EC"/>
        </Style>

        <Style x:Key="CrazyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#F5D6E4"/>
            <Setter Property="BorderBrush" Value="#E8BFD1"/>
        </Style>

        <Style x:Key="CommunicateButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#E2DDF5"/>
            <Setter Property="BorderBrush" Value="#CEC5EA"/>
        </Style>

        <Style x:Key="CoffeeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FBE1C5"/>
            <Setter Property="BorderBrush" Value="#F0CDA8"/>
        </Style>

        <Style x:Key="FixButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#D8F0DF"/>
            <Setter Property="BorderBrush" Value="#BFDCC8"/>
        </Style>

        <Style x:Key="RemoveButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FBE0DE"/>
            <Setter Property="BorderBrush" Value="#F0C3BF"/>
            <Setter Property="Foreground" Value="#A94F49"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Pet Office"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#344054"/>

                    <TextBlock Text="Where serious business meets paws"
                               FontSize="13"
                               Foreground="#7B8790"
                               Margin="1,4,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Image Source="/PetOffice.WpfApp;component/Assets/cat.png"
                           Width="48"
                           Height="48"
                           Stretch="Uniform"
                           Margin="0,0,8,0"/>

                    <Image Source="/PetOffice.WpfApp;component/Assets/dog.png"
                           Width="48"
                           Height="48"
                           Stretch="Uniform"
                           Margin="0,0,8,0"/>

                    <Image Source="/PetOffice.WpfApp;component/Assets/hamster.png"
                           Width="48"
                           Height="48"
                           Stretch="Uniform"
                           Margin="0,0,8,0"/>

                    <Image Source="/PetOffice.WpfApp;component/Assets/parrot.png"
                           Width="48"
                           Height="48"
                           Stretch="Uniform"
                           Margin="0,0,8,0"/>

                    <Image Source="/PetOffice.WpfApp;component/Assets/rabbit.png"
                           Width="48"
                           Height="48"
                           Stretch="Uniform"
                           Margin="0,0,8,0"/>

                    <Image Source="/PetOffice.WpfApp;component/Assets/owl.png"
                           Width="48"
                           Height="48"
                           Stretch="Uniform"
                           Margin="0,0,8,0"/>

                    <Image Source="/PetOffice.WpfApp;component/Assets/raccoon.png"
                           Width="48"
                           Height="48"
                           Stretch="Uniform"/>

                </StackPanel>

            </Grid>

            <!-- TOP -->
            <Grid Grid.Row="1"
                  Margin="0,0,0,16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="370"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ADD OFFICE PET -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Background="#FFF4E8">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,18">

                            <Image Source="/PetOffice.WpfApp;component/Assets/add.png"
                                   Width="27"
                                   Height="27"
                                   Stretch="Uniform"
                                   Margin="0,0,10,0"/>

                            <TextBlock Text="Add office pet"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <Grid Grid.Row="1"
                              Margin="0,0,0,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Type"
                                       VerticalAlignment="Center"
                                       Foreground="#59666D"/>

                            <Border Grid.Column="1"
                                    Height="38"
                                    Background="#D9FFFFFF"
                                    BorderBrush="#D7CFC7"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <ComboBox
                                    Style="{StaticResource InputComboBoxStyle}"
                                    ItemsSource="{Binding RepositoryNames}"
                                    SelectedItem="{Binding SelectedRepository,
                                                           Mode=TwoWay}"/>

                            </Border>

                        </Grid>

                        <Grid Grid.Row="2"
                              Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Image Source="/PetOffice.WpfApp;component/Assets/pet_name.png"
                                       Width="18"
                                       Height="18"
                                       Stretch="Uniform"
                                       Margin="0,0,6,0"/>

                                <TextBlock Text="Name"
                                           VerticalAlignment="Center"
                                           Foreground="#59666D"/>

                            </StackPanel>

                            <Border Grid.Column="1"
                                    Height="38"
                                    Background="#D9FFFFFF"
                                    BorderBrush="#D7CFC7"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <TextBox
                                    Style="{StaticResource InputTextBoxStyle}"
                                    Text="{Binding NewPetName,
                                                   Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}"/>

                            </Border>

                        </Grid>

                        <Button Grid.Row="3"
                                Style="{StaticResource AddButtonStyle}"
                                Command="{Binding AddCommand}">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/PetOffice.WpfApp;component/Assets/add.png"
                                       Width="19"
                                       Height="19"
                                       Stretch="Uniform"
                                       Margin="0,0,7,0"/>

                                <TextBlock Text="Add pet"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </Grid>

                </Border>

                <!-- OFFICE PETS -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        Background="#EDF6FC">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="160"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,12">

                            <Image Source="/PetOffice.WpfApp;component/Assets/service.png"
                                   Width="27"
                                   Height="27"
                                   Stretch="Uniform"
                                   Margin="0,0,10,0"/>

                            <TextBlock Text="Office pets"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="#CCFFFFFF"
                                BorderBrush="#CCDCE7"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="2">

                            <ListBox
                                ItemsSource="{Binding VisiblePets}"
                                SelectedItem="{Binding SelectedPet,
                                                       Mode=TwoWay}"
                                DisplayMemberPath="DisplayName"
                                FontSize="14"
                                Padding="6"
                                Background="Transparent"
                                BorderThickness="0"/>

                        </Border>

                    </Grid>

                </Border>

            </Grid>

            <!-- SELECTED PET -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}"
                    Background="#F5F0FA"
                    Margin="0,0,0,16">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">

                            <Image Source="/PetOffice.WpfApp;component/Assets/badge.png"
                                   Width="27"
                                   Height="27"
                                   Stretch="Uniform"
                                   Margin="0,0,10,0"/>

                            <TextBlock Text="Selected pet"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="130"
                                Style="{StaticResource RemoveButtonStyle}"
                                Command="{Binding RemoveCommand}">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/PetOffice.WpfApp;component/Assets/remove.png"
                                       Width="18"
                                       Height="18"
                                       Margin="0,0,7,0"/>

                                <TextBlock Text="Remove"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding SelectedPetDisplayName}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#477D9D"
                               Margin="0,0,0,15"/>

                    <Grid Grid.Row="2"
                          Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal">

                            <Image Source="/PetOffice.WpfApp;component/Assets/energy.png"
                                   Width="19"
                                   Height="19"
                                   Margin="0,0,6,0"/>

                            <TextBlock Text="Energy"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <ProgressBar Grid.Column="1"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding SelectedPetEnergy, Mode=OneWay}"
                                     Margin="0,0,12,0"
                                     Style="{StaticResource EnergyProgressBarStyle}"/>

                        <Border Grid.Column="2"
                                Background="#99FFFFFF"
                                CornerRadius="8"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">

                            <TextBlock
                                Text="{Binding SelectedPetEnergyText}"
                                VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <TextBlock
                                Text="{Binding SelectedPetTasksText}"
                                HorizontalAlignment="Right"
                                Foreground="#667085"/>

                            <TextBlock
                                Text="{Binding SelectedPetReactionsText}"
                                HorizontalAlignment="Right"
                                Foreground="#667085"
                                Margin="0,3,0,0"/>

                        </StackPanel>

                    </Grid>

                    <!-- MAIN ACTIONS -->
                    <Grid Grid.Row="3"
                          Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource WorkButtonStyle}"
                                Command="{Binding WorkCommand}">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/PetOffice.WpfApp;component/Assets/work.png"
                                       Width="22"
                                       Height="22"
                                       Margin="0,0,8,0"/>

                                <TextBlock Text="Work"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource CrazyButtonStyle}"
                                Command="{Binding CrazyCommand}">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/PetOffice.WpfApp;component/Assets/action.png"
                                       Width="22"
                                       Height="22"
                                       Margin="0,0,8,0"/>

                                <TextBlock Text="Crazy Action"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </Grid>

                    <!-- ABILITIES -->
                    <Grid Grid.Row="4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource CommunicateButtonStyle}"
                                Command="{Binding CommunicateCommand}">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/PetOffice.WpfApp;component/Assets/speech-bubble.png"
                                       Width="22"
                                       Height="22"
                                       Margin="0,0,8,0"/>

                                <TextBlock Text="Communicate"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource CoffeeButtonStyle}"
                                Command="{Binding CoffeeCommand}">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/PetOffice.WpfApp;component/Assets/coffee-cup.png"
                                       Width="22"
                                       Height="22"
                                       Margin="0,0,8,0"/>

                                <TextBlock Text="Make coffee"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        <Button Grid.Column="4"
                                Style="{StaticResource FixButtonStyle}"
                                Command="{Binding FixCommand}">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/PetOffice.WpfApp;component/Assets/fix.png"
                                       Width="22"
                                       Height="22"
                                       Margin="0,0,8,0"/>

                                <TextBlock Text="Fix computer"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </Grid>

                </Grid>

            </Border>

            <!-- LINQ -->
            <Border Grid.Row="3"
                    Style="{StaticResource CardStyle}"
                    Background="#FFF8EC"
                    Margin="0,0,0,16">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Search, sort and summary"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Search by name"
                                       Foreground="#59666D"
                                       Margin="0,0,0,5"/>

                            <Border Background="#D9FFFFFF"
                                    BorderBrush="#D7CFC7"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <TextBox
                                    Style="{StaticResource InputTextBoxStyle}"
                                    Text="{Binding SearchText,
                                                   Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}"/>

                            </Border>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Sort"
                                       Foreground="#59666D"
                                       Margin="0,0,0,5"/>

                            <Border Background="#D9FFFFFF"
                                    BorderBrush="#D7CFC7"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <ComboBox
                                    Style="{StaticResource InputComboBoxStyle}"
                                    ItemsSource="{Binding SortOptions}"
                                    SelectedItem="{Binding SelectedSortOption,
                                                           Mode=TwoWay}"/>

                            </Border>

                        </StackPanel>

                        <StackPanel Grid.Column="4">

                            <TextBlock Text="Summary by type"
                                       Foreground="#59666D"
                                       Margin="0,0,0,5"/>

                            <Border Background="#D9FFFFFF"
                                    BorderBrush="#D7CFC7"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6">

                                <ListBox ItemsSource="{Binding Summary}"
                                         Height="80"
                                         Background="Transparent"
                                         BorderThickness="0"/>

                            </Border>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>

            <!-- ACTIVITY LOG -->
            <Border Grid.Row="4"
                    Style="{StaticResource CardStyle}"
                    Background="#EFF8F2"
                    Margin="0,0,0,20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <Image Source="/PetOffice.WpfApp;component/Assets/log.png"
                               Width="25"
                               Height="25"
                               Stretch="Uniform"
                               Margin="0,0,9,0"/>

                        <TextBlock Text="Activity log"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#CCFFFFFF"
                            BorderBrush="#CFE0D4"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="2">

                        <ListBox ItemsSource="{Binding Log}"
                                 FontSize="13"
                                 Padding="7"
                                 Background="Transparent"
                                 BorderThickness="0"/>

                    </Border>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>
