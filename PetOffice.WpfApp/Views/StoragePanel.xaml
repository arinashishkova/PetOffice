<UserControl x:Class="PetOffice.WpfApp.Views.StoragePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="World Storage"
                       FontSize="26"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Save and restore the current Pet Office world."
                       Margin="0,5,0,0"
                       Foreground="#6B7280"/>
        </StackPanel>

        <!-- JSON -->
        <Border Grid.Row="1"
                Padding="18"
                Margin="0,0,0,14"
                Background="White"
                BorderBrush="#DFE3E6"
                BorderThickness="1"
                CornerRadius="12">

            <StackPanel>
                <TextBlock Text="JSON"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Save the complete office state to a JSON file or restore it later."
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save JSON"
                            Command="{Binding SaveJsonCommand}"
                            MinWidth="120"
                            Padding="14,8"
                            Margin="0,0,10,0"/>

                    <Button Content="Load JSON"
                            Command="{Binding LoadJsonCommand}"
                            MinWidth="120"
                            Padding="14,8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- XML -->
        <Border Grid.Row="2"
                Padding="18"
                Margin="0,0,0,14"
                Background="White"
                BorderBrush="#DFE3E6"
                BorderThickness="1"
                CornerRadius="12">

            <StackPanel>
                <TextBlock Text="XML"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Save the complete office state to an XML file or restore it later."
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save XML"
                            Command="{Binding SaveXmlCommand}"
                            MinWidth="120"
                            Padding="14,8"
                            Margin="0,0,10,0"/>

                    <Button Content="Load XML"
                            Command="{Binding LoadXmlCommand}"
                            MinWidth="120"
                            Padding="14,8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- LocalDB -->
        <Border Grid.Row="3"
                Padding="18"
                Margin="0,0,0,14"
                Background="White"
                BorderBrush="#DFE3E6"
                BorderThickness="1"
                CornerRadius="12">

            <StackPanel>
                <TextBlock Text="LocalDB"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Save or restore the complete office state using SQL Server LocalDB."
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save to LocalDB"
                            Command="{Binding SaveLocalDbCommand}"
                            MinWidth="140"
                            Padding="14,8"
                            Margin="0,0,10,0"/>

                    <Button Content="Load from LocalDB"
                            Command="{Binding LoadLocalDbCommand}"
                            MinWidth="140"
                            Padding="14,8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="4"
                Padding="16"
                Background="#F4F6FA"
                BorderBrush="#DFE3E6"
                BorderThickness="1"
                CornerRadius="10">

            <StackPanel>
                <TextBlock Text="Status"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBlock Text="{Binding StorageStatus}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>