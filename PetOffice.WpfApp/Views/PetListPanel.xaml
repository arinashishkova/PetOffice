                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" Background="#FBEFE3" CornerRadius="8">
                    <Image Source="/PetOffice.WpfApp;component/Assets/raccoon.png" Width="27" Height="27"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Raccoon Barista" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,3,0">
                    <Image Source="/PetOffice.WpfApp;component/Assets/energy.png" Width="15" Height="15" Opacity="0.8"/>
                    <TextBlock Text="{Binding Energy}" Margin="4,0,0,0" FontSize="12" Foreground="#7C6B48"/>
                </StackPanel>
            </Grid>
