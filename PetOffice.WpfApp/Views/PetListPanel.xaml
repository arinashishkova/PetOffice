<UserControl x:Class="PetOffice.WpfApp.Views.PetListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PetOffice.Core.Models;assembly=PetOffice.Core">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- PET LIST ITEM                                         -->
        <!-- ===================================================== -->
        <Style x:Key="PetListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="8">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF6FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#DCECF7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ===================================================== -->
        <!-- PET TEMPLATES                                         -->
        <!-- ===================================================== -->

        <!-- CAT -->
        <DataTemplate DataType="{x:Type models:CatManager}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" Background="#FFF4E8" CornerRadius="8">
                    <Image Source="/PetOffice.WpfApp;component/Assets/cat.png" Width="27" Height="27"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Cat Manager" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,3,0">
                    <Image Source="/PetOffice.WpfApp;component/Assets/energy.png" Width="15" Height="15" Opacity="0.8"/>
                    <TextBlock Text="{Binding Energy}" Margin="4,0,0,0" FontSize="12" Foreground="#7C6B48"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- DOG -->
        <DataTemplate DataType="{x:Type models:DogIntern}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" Background="#F5F0FA" CornerRadius="8">
                    <Image Source="/PetOffice.WpfApp;component/Assets/dog.png" Width="27" Height="27"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Dog Intern" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,3,0">
                    <Image Source="/PetOffice.WpfApp;component/Assets/energy.png" Width="15" Height="15" Opacity="0.8"/>
                    <TextBlock Text="{Binding Energy}" Margin="4,0,0,0" FontSize="12" Foreground="#7C6B48"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- HAMSTER -->
        <DataTemplate DataType="{x:Type models:HamsterIT}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" Background="#FFF8EC" CornerRadius="8">
                    <Image Source="/PetOffice.WpfApp;component/Assets/hamster.png" Width="27" Height="27"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Hamster IT" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,3,0">
                    <Image Source="/PetOffice.WpfApp;component/Assets/energy.png" Width="15" Height="15" Opacity="0.8"/>
                    <TextBlock Text="{Binding Energy}" Margin="4,0,0,0" FontSize="12" Foreground="#7C6B48"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- PARROT -->
        <DataTemplate DataType="{x:Type models:ParrotReceptionist}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" Background="#EFF8F2" CornerRadius="8">
                    <Image Source="/PetOffice.WpfApp;component/Assets/parrot.png" Width="27" Height="27"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Parrot Receptionist" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,3,0">
                    <Image Source="/PetOffice.WpfApp;component/Assets/energy.png" Width="15" Height="15" Opacity="0.8"/>
                    <TextBlock Text="{Binding Energy}" Margin="4,0,0,0" FontSize="12" Foreground="#7C6B48"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- RABBIT -->
        <DataTemplate DataType="{x:Type models:RabbitAccountant}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" Background="#FDEFF5" CornerRadius="8">
                    <Image Source="/PetOffice.WpfApp;component/Assets/rabbit.png" Width="27" Height="27"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
