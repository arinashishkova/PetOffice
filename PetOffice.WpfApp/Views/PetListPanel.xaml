    <Border Background="#EDF6FC"
            BorderBrush="#DFE3E6"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20">

        <Grid>

            <!-- WATERMARK -->
            <Rectangle IsHitTestVisible="False"
                       Opacity="0.03">

                <Rectangle.Fill>

                    <DrawingBrush TileMode="Tile"
                                  Viewport="0,0,160,120"
                                  ViewportUnits="Absolute"
                                  Stretch="None">

                        <DrawingBrush.Drawing>

                            <DrawingGroup>

                                <ImageDrawing
                                    ImageSource="/PetOffice.WpfApp;component/Assets/paw.png"
                                    Rect="18,10,28,28"/>

                                <ImageDrawing
                                    ImageSource="/PetOffice.WpfApp;component/Assets/paw.png"
                                    Rect="98,70,28,28"/>

                            </DrawingGroup>

                        </DrawingBrush.Drawing>

                    </DrawingBrush>

                </Rectangle.Fill>

            </Rectangle>


            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- HEADER -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,14">

                    <Image Source="/PetOffice.WpfApp;component/Assets/service.png"
                           Width="27"
                           Height="27"
                           Margin="0,0,10,0"/>

                    <TextBlock Text="Office pets"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#344054"
                               VerticalAlignment="Center"/>

                </StackPanel>


                <!-- SEARCH + SORT -->
                <Grid Grid.Row="1"
                      Margin="0,0,0,12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Search"
                                   FontSize="12"
                                   Foreground="#667085"
                                   Margin="2,0,0,4"/>

                        <Border Height="38"
                                Background="#F9FCFE"
                                BorderBrush="#CCDCE7"
                                BorderThickness="1"
                                CornerRadius="8">

                            <TextBox
                                Style="{StaticResource CompactTextBoxStyle}"
                                Text="{Binding SearchText,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}"/>

                        </Border>

                    </StackPanel>


                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Sort"
                                   FontSize="12"
                                   Foreground="#667085"
                                   Margin="2,0,0,4"/>

                        <ComboBox
                            Style="{StaticResource CompactComboBoxStyle}"
                            ItemsSource="{Binding SortOptions}"
                            SelectedItem="{Binding SelectedSortOption,
                                                   Mode=TwoWay}"/>

                    </StackPanel>

                </Grid>


                <!-- GROUP FILTERS -->
                <Grid Grid.Row="2"
                      Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Groups"
                               FontSize="12"
                               Foreground="#667085"
                               VerticalAlignment="Center"
                               Margin="2,0,12,0"/>

                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding GroupFilters}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Button
                                    Style="{StaticResource GroupFilterButtonStyle}"
                                    Command="{Binding DataContext.ToggleGroupFilterCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding DisplayName}"
                                    Margin="0,0,7,5">

                                    <StackPanel Orientation="Horizontal">

                                        <Image Source="{Binding IconPath}"
                                               Width="20"
                                               Height="20"
                                               Stretch="Uniform"/>

                                        <TextBlock Text="{Binding Count}"
                                                   Margin="5,0,0,0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#59666D"
                                                   VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Button>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </Grid>


                <!-- PET LIST -->
                <Border Grid.Row="3"
                        Background="#F4FFFFFF"
                        BorderBrush="#CCDCE7"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8"
                        MinHeight="190"
                        MaxHeight="360">

                    <ListBox
                        ItemsSource="{Binding FilteredPetsView}"
                        SelectedItem="{Binding SelectedPet,
                                               Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource PetListItemStyle}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        ScrollViewer.VerticalScrollBarVisibility="Visible"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.Resources>

                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource ThinScrollBarStyle}"/>

                        </ListBox.Resources>

                    </ListBox>

                </Border>

            </Grid>

        </Grid>

    </Border>

</UserControl>