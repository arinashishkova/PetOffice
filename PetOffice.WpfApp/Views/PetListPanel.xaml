<UserControl x:Class="PetOffice.WpfApp.Views.PetListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:converters="clr-namespace:PetOffice.WpfApp.Converters"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PetOffice.Core.Models;assembly=PetOffice.Core">

    <UserControl.Resources>

        <converters:PetVisualConverter x:Key="PetVisualConverter"/>

        <!-- ===================================================== -->
        <!-- PET LIST ITEM                                         -->
        <!-- ===================================================== -->
        <Style x:Key="PetListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="8">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF6FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#DCECF7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ===================================================== -->
        <!-- PET TEMPLATES                                         -->
        <!-- ===================================================== -->

       

    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- OFFICE PETS CARD                                          -->
    <!-- ========================================================= -->
    <Border Background="{StaticResource PetsCardBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}"
            Padding="{StaticResource CardPadding}">
        <Grid>
            <!-- BACKGROUND PATTERN -->
            <Rectangle Fill="{StaticResource PetListWatermarkBrush}" IsHitTestVisible="False"/>

            <!-- CONTENT -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <!-- Иконка с цифрой внутри -->
                    <Grid Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="/PetOffice.WpfApp;component/Assets/total_office.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="{Binding TotalPetsCount, Mode=OneWay}"
                                   FontSize="11" FontWeight="Bold" Foreground="#344054"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Office pets" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- SEARCH + SORT -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>

                    <!-- SEARCH -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Search" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,4"/>
                        <Border Height="38" Background="{StaticResource SearchSurfaceBrush}" BorderBrush="{StaticResource BlueBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <TextBox Style="{StaticResource CompactTextBoxStyle}"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </StackPanel>

                    <!-- SORT -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Sort" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,4"/>
                        <ComboBox Style="{StaticResource CompactComboBoxStyle}"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>

                <!-- GROUP FILTERS -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Groups" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,12,0"/>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding GroupFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GroupFilterButtonStyle}"
                                        Command="{Binding DataContext.ToggleGroupFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding DisplayName}"
                                        Margin="0,0,7,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding IconPath}" Width="20" Height="20" Stretch="Uniform"/>
                                        <TextBlock Text="{Binding Count}" Margin="5,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#59666D" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- PET LIST -->
                <Border Grid.Row="3" Background="#F4FFFFFF" BorderBrush="{StaticResource BlueBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8" MinHeight="190" MaxHeight="360">
                    <ListBox ItemsSource="{Binding FilteredPetsView}"
                             SelectedItem="{Binding SelectedPet, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource PetListItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}"/>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- PET ICON -->
                                    <Border Grid.Column="0"
                    Width="34"
                    Height="34"
                    CornerRadius="8"
                    Background="{Binding Converter={StaticResource PetVisualConverter},
                                         ConverterParameter=Background}">

                                        <Image Source="{Binding Converter={StaticResource PetVisualConverter},
                                        ConverterParameter=Icon}"
                       Width="27"
                       Height="27"
                       Stretch="Uniform"/>

                                    </Border>

                                    <!-- PET NAME, ROLE AND GROUP -->
                                    <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Name}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                        <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                                            <TextBlock Text="{Binding Converter={StaticResource PetVisualConverter},
                                              ConverterParameter=Role}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>

                                            <Image Source="{Binding GroupName,
                                            Converter={StaticResource PetVisualConverter},
                                            ConverterParameter=GroupIcon}"
                           Width="18"
                           Height="18"
                           Margin="8,0,0,0"
                           Stretch="Uniform"
                           ToolTip="{Binding GroupName}"/>

                                        </StackPanel>

                                    </StackPanel>

                                    <!-- ENERGY -->
                                    <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0,3,0">

                                        <Image Source="/PetOffice.WpfApp;component/Assets/energy.png"
                       Width="15"
                       Height="15"
                       Opacity="0.8"/>

                                        <TextBlock Text="{Binding Energy}"
                           Margin="4,0,0,0"
                           FontSize="12"
                           Foreground="#7C6B48"/>

                                    </StackPanel>

                                </Grid>

                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

            </Grid>
        </Grid>
    </Border>

</UserControl>