<UserControl x:Class="PetOffice.WpfApp.Views.PetDetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PetOffice.WpfApp.Converters">

    <UserControl.Resources>
        <converters:EnergyLevelBrushConverter x:Key="EnergyLevelBrushConverter"/>
    </UserControl.Resources>

    <Border Background="{StaticResource SelectedCardBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}"
            Padding="{StaticResource CardPadding}">
        <Grid>
            <!-- BACKGROUND PATTERN -->
            <Rectangle Fill="{StaticResource SelectedWatermarkBrush}" IsHitTestVisible="False"/>

            <!-- CONTENT -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/PetOffice.WpfApp;component/Assets/badge.png" Width="32" Height="32" Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBlock Text="Selected pet" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Width="88" Height="34" Style="{StaticResource RemoveButtonStyle}" Command="{Binding RemoveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/PetOffice.WpfApp;component/Assets/remove.png" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Remove" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- PET NAME + GROUP -->
                <Border Grid.Row="1" Background="#80FFFFFF" CornerRadius="8" Padding="10,9" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <!-- PET ICON -->
                        <Border Grid.Column="0" Width="44" Height="44" Background="#70FFFFFF" CornerRadius="9" VerticalAlignment="Center">
                            <Image Source="{Binding SelectedPetIconPath}" Width="38" Height="38" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- NAME AND CLASS -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                            <TextBlock Text="{Binding SelectedPetName}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedPetType}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- GROUP -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Group" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>

                            <ComboBox Style="{StaticResource RoundedComboBoxStyle}"
                                      ItemsSource="{Binding OfficeGroupOptions}"
                                      SelectedValuePath="Name"
                                      SelectedValue="{Binding SelectedPetGroup, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding IconPath}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ENERGY -->
                <Grid Grid.Row="2" Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ENERGY BAR -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Image Source="/PetOffice.WpfApp;component/Assets/energy.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Energy" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ProgressBar Grid.Column="1" Style="{StaticResource RoundedEnergyProgressBarStyle}" Minimum="0" Maximum="100"
                                     Value="{Binding SelectedPetEnergy, Mode=OneWay}"
                                     Margin="0,0,10,0"
                                     Foreground="{Binding SelectedPetEnergy, Converter={StaticResource EnergyLevelBrushConverter}}"/>

                        <TextBlock Grid.Column="2" Text="{Binding SelectedPetEnergyText}"
                                   Foreground="{Binding SelectedPetEnergy, Converter={StaticResource EnergyLevelBrushConverter}}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- STATISTICS -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding SelectedPetTasksText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedPetReactionsText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>

                <!-- MAIN ACTIONS -->
                <Grid Grid.Row="3" Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource WorkButtonStyle}" Command="{Binding WorkCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/PetOffice.WpfApp;component/Assets/work.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Work" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource CrazyButtonStyle}" Command="{Binding CrazyCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/PetOffice.WpfApp;component/Assets/action.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Crazy" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" Style="{StaticResource RestoreButtonStyle}" Command="{Binding RestoreEnergyCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/PetOffice.WpfApp;component/Assets/restore.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Restore" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ABILITIES -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource AbilityButtonStyle}" Command="{Binding CommunicateCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/PetOffice.WpfApp;component/Assets/speech-bubble.png" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="Talk"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource AbilityButtonStyle}" Command="{Binding CoffeeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/PetOffice.WpfApp;component/Assets/coffee-cup.png" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="Coffee"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" Style="{StaticResource AbilityButtonStyle}" Command="{Binding FixCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/PetOffice.WpfApp;component/Assets/fix.png" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="Fix PC"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- PET ID -->
                <TextBlock Grid.Row="5"
                           Text="{Binding SelectedPetIdText}"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="2,0,0,12"/>
            </Grid>
        </Grid>
    </Border>

</UserControl>