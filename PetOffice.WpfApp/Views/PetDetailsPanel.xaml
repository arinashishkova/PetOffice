<UserControl x:Class="PetOffice.WpfApp.Views.PetDetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PetOffice.WpfApp.Converters">

    <UserControl.Resources>

        <!-- ROUNDED ENERGY BAR -->
        <Style x:Key="RoundedEnergyProgressBarStyle"
       TargetType="ProgressBar">

            <Setter Property="Height"
            Value="18"/>

            <Setter Property="Background"
            Value="#E7E3EA"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ProgressBar">

                        <Grid x:Name="PART_Track">

                            <Border Background="{TemplateBinding Background}"
                            CornerRadius="9"/>

                            <Border x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="9"/>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <converters:EnergyLevelBrushConverter
    x:Key="EnergyLevelBrushConverter"/>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Padding"
                    Value="9,5"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.78"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.32"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <Style x:Key="WorkButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">

            <Setter Property="Background"
                    Value="#D7EAF7"/>

            <Setter Property="BorderBrush"
                    Value="#BDD9EC"/>

        </Style>


        <Style x:Key="CrazyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">

            <Setter Property="Background"
                    Value="#F5D6E4"/>

            <Setter Property="BorderBrush"
                    Value="#E8BFD1"/>

        </Style>


        <Style x:Key="RestoreButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">

            <Setter Property="Background"
                    Value="#E3F3E6"/>

            <Setter Property="BorderBrush"
                    Value="#B8D8BE"/>

            <Setter Property="Foreground"
                    Value="#3F6F48"/>

        </Style>


        <Style x:Key="AbilityButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">

            <Setter Property="Background"
                    Value="#F0ECF8"/>

            <Setter Property="BorderBrush"
                    Value="#D7CFEA"/>

        </Style>


        <Style x:Key="RemoveButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">

            <Setter Property="Background"
                    Value="#FBE0DE"/>

            <Setter Property="BorderBrush"
                    Value="#F0C3BF"/>

            <Setter Property="Foreground"
                    Value="#A94F49"/>

        </Style>

    </UserControl.Resources>


    <Border Background="#F5F0FA"
            BorderBrush="#DFE3E6"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20">

        <Grid>

            <!-- SELECTED PET WATERMARK -->
            <Rectangle IsHitTestVisible="False"
           Opacity="0.035">

                <Rectangle.Fill>

                    <DrawingBrush TileMode="Tile"
              Viewport="0,0,110,78"
              ViewportUnits="Absolute"
              Stretch="None">

                        <DrawingBrush.Drawing>

                            <DrawingGroup>

                                <ImageDrawing
                ImageSource="/PetOffice.WpfApp;component/Assets/selected_back_watermarkpng.png"
                Rect="10,7,18,18"/>

                                <ImageDrawing
                ImageSource="/PetOffice.WpfApp;component/Assets/selected_back_watermarkpng.png"
                Rect="62,42,18,18"/>

                            </DrawingGroup>

                        </DrawingBrush.Drawing>

                    </DrawingBrush>

                </Rectangle.Fill>

            </Rectangle>


            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- HEADER -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Image Source="/PetOffice.WpfApp;component/Assets/badge.png"
                               Width="25"
                               Height="25"
                               Stretch="Uniform"
                               Margin="0,0,9,0"/>

                        <TextBlock Text="Selected pet"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#344054"
                                   VerticalAlignment="Center"/>

                    </StackPanel>


                    <Button Grid.Column="1"
                            Width="88"
                            Height="34"
                            Style="{StaticResource RemoveButtonStyle}"
                            Command="{Binding RemoveCommand}">

                        <StackPanel Orientation="Horizontal">

                            <Image Source="/PetOffice.WpfApp;component/Assets/remove.png"
                                   Width="15"
                                   Height="15"
                                   Stretch="Uniform"
                                   Margin="0,0,5,0"/>

                            <TextBlock Text="Remove"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </Grid>


                <!-- PET NAME -->
                <Border Grid.Row="1"
        Background="#80FFFFFF"
        CornerRadius="8"
        Padding="10,7"
        Margin="0,0,0,14">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock
            Text="{Binding SelectedPetDisplayName}"
            FontSize="17"
            FontWeight="SemiBold"
            Foreground="#252A30"
            TextWrapping="Wrap"
            VerticalAlignment="Center"/>


                        <Border Grid.Column="1"
                Width="40"
                Height="40"
                Margin="12,0,0,0"
                Background="#70FFFFFF"
                CornerRadius="9">

                            <Image
                Source="{Binding SelectedPetIconPath}"
                Width="32"
                Height="32"
                Stretch="Uniform"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- ENERGY -->
                <Grid Grid.Row="2"
                      Margin="0,0,0,15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,9,0">

                            <Image Source="/PetOffice.WpfApp;component/Assets/energy.png"
                                   Width="18"
                                   Height="18"
                                   Stretch="Uniform"
                                   Margin="0,0,5,0"/>

                            <TextBlock Text="Energy"
                                       Foreground="#59666D"
                                       VerticalAlignment="Center"/>

                        </StackPanel>


                        <ProgressBar Grid.Column="1"
                                     Style="{StaticResource RoundedEnergyProgressBarStyle}"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding SelectedPetEnergy,
                                                     Mode=OneWay}"
                                     Margin="0,0,10,0"
                                     Foreground="{Binding SelectedPetEnergy,
                                                          Converter={StaticResource EnergyLevelBrushConverter}}"/>


                        <TextBlock Grid.Column="2"
                                   Text="{Binding SelectedPetEnergyText}"
                                   Foreground="{Binding SelectedPetEnergy,
                                                        Converter={StaticResource EnergyLevelBrushConverter}}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                    </Grid>


                    <Grid Grid.Row="1"
                          Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding SelectedPetTasksText}"
                                   FontSize="12"
                                   Foreground="#667085"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedPetReactionsText}"
                                   FontSize="12"
                                   Foreground="#667085"
                                   HorizontalAlignment="Right"/>

                    </Grid>

                </Grid>


                <!-- MAIN ACTIONS -->
                <Grid Grid.Row="3"
                      Margin="0,0,0,9">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <Button Grid.Column="0"
                            Style="{StaticResource WorkButtonStyle}"
                            Command="{Binding WorkCommand}">

                        <StackPanel Orientation="Horizontal">

                            <Image Source="/PetOffice.WpfApp;component/Assets/work.png"
                                   Width="18"
                                   Height="18"
                                   Stretch="Uniform"
                                   Margin="0,0,5,0"/>

                            <TextBlock Text="Work"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button Grid.Column="2"
                            Style="{StaticResource CrazyButtonStyle}"
                            Command="{Binding CrazyCommand}">

                        <StackPanel Orientation="Horizontal">

                            <Image Source="/PetOffice.WpfApp;component/Assets/action.png"
                                   Width="18"
                                   Height="18"
                                   Stretch="Uniform"
                                   Margin="0,0,5,0"/>

                            <TextBlock Text="Crazy"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button Grid.Column="4"
                            Style="{StaticResource RestoreButtonStyle}"
                            Command="{Binding RestoreEnergyCommand}">

                        <StackPanel Orientation="Horizontal">

                            <Image Source="/PetOffice.WpfApp;component/Assets/restore.png"
                                   Width="18"
                                   Height="18"
                                   Stretch="Uniform"
                                   Margin="0,0,5,0"/>

                            <TextBlock Text="Restore"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </Grid>


                <!-- ABILITIES -->
                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <Button Grid.Column="0"
                            Style="{StaticResource AbilityButtonStyle}"
                            Command="{Binding CommunicateCommand}">

                        <StackPanel Orientation="Horizontal">

                            <Image Source="/PetOffice.WpfApp;component/Assets/speech-bubble.png"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,4,0"/>

                            <TextBlock Text="Talk"/>

                        </StackPanel>

                    </Button>


                    <Button Grid.Column="2"
                            Style="{StaticResource AbilityButtonStyle}"
                            Command="{Binding CoffeeCommand}">

                        <StackPanel Orientation="Horizontal">

                            <Image Source="/PetOffice.WpfApp;component/Assets/coffee-cup.png"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,4,0"/>

                            <TextBlock Text="Coffee"/>

                        </StackPanel>

                    </Button>


                    <Button Grid.Column="4"
                            Style="{StaticResource AbilityButtonStyle}"
                            Command="{Binding FixCommand}">

                        <StackPanel Orientation="Horizontal">

                            <Image Source="/PetOffice.WpfApp;component/Assets/fix.png"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,4,0"/>

                            <TextBlock Text="Fix PC"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </Grid>

        </Grid>

    </Border>

</UserControl>