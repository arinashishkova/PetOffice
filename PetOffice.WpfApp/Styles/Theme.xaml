<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- IMAGE RESOURCES -->
    <BitmapImage x:Key="FingerprintIcon" UriSource="pack://application:,,,/PetOffice.WpfApp;component/Assets/id_fingerprint.png"/>

    <!-- ========================================================= -->
    <!-- FONT                                                      -->
    <!-- Change this one value to change the whole app font later. -->
    <!-- ========================================================= -->
    <FontFamily x:Key="AppFontFamily">Cascadia Code</FontFamily>


    <!-- ========================================================= -->
    <!-- GENERAL COLORS                                            -->
    <!-- ========================================================= -->
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F8F6F4"/>
    <SolidColorBrush x:Key="MainSurfaceBrush" Color="#FFFDFC"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextStrongBrush" Color="#252A30"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#344054"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7B8790"/>

    <!-- General Borders -->
    <SolidColorBrush x:Key="AppBorderBrush" Color="#DFE3E6"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D7CFC7"/>
    <SolidColorBrush x:Key="BlueBorderBrush" Color="#CCDCE7"/>

    <!-- Input Surfaces -->
    <SolidColorBrush x:Key="InputSurfaceBrush" Color="#FDFBFA"/>
    <SolidColorBrush x:Key="SearchSurfaceBrush" Color="#F9FCFE"/>


    <!-- ========================================================= -->
    <!-- CARD BACKGROUNDS                                          -->
    <!-- ========================================================= -->
    <SolidColorBrush x:Key="AddCardBrush" Color="#FFF4E8"/>
    <SolidColorBrush x:Key="SelectedCardBrush" Color="#F5F0FA"/>
    <SolidColorBrush x:Key="PetsCardBrush" Color="#EDF6FC"/>
    <SolidColorBrush x:Key="LogCardBrush" Color="#EFF8F2"/>


    <!-- ========================================================= -->
    <!-- COMBOBOX                                                  -->
    <!-- ========================================================= -->
    <SolidColorBrush x:Key="ComboItemHoverBrush" Color="#F3F0F6"/>
    <SolidColorBrush x:Key="ComboItemSelectedBrush" Color="#E7E1F2"/>
    <SolidColorBrush x:Key="ComboOpenBorderBrush" Color="#9CA3AF"/>


    <!-- ========================================================= -->
    <!-- SCROLLBAR                                                 -->
    <!-- ========================================================= -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#B8C2CB"/>


    <!-- ========================================================= -->
    <!-- LOG                                                       -->
    <!-- ========================================================= -->
    <SolidColorBrush x:Key="LogItemHoverBrush" Color="#EEF8F0"/>
    <SolidColorBrush x:Key="LogItemSelectedBrush" Color="#DFF1E6"/>


    <!-- CPU ANALYSIS SELECTION -->
    <SolidColorBrush x:Key="AnalysisRowHoverBrush" Color="#EFF1F9"/>
    <SolidColorBrush x:Key="AnalysisRowSelectedBrush" Color="#E1E5F3"/>


    <!-- ========================================================= -->
    <!-- TABS                                                      -->
    <!-- ========================================================= -->
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="TabBorderBrush" Color="#E0E4E8"/>
    <SolidColorBrush x:Key="TabHoverBrush" Color="#ECEFF3"/>
    <SolidColorBrush x:Key="TabSelectedBrush" Color="#E2DDF5"/>
    <SolidColorBrush x:Key="TabSelectedBorderBrush" Color="#CEC5EA"/>
    <SolidColorBrush x:Key="TabSelectedTextBrush" Color="#4F4775"/>


    <!-- ========================================================= -->
    <!-- BUTTON COLORS                                             -->
    <!-- ========================================================= -->
    <SolidColorBrush x:Key="AddButtonBackgroundBrush" Color="#B7D8D3"/>
    <SolidColorBrush x:Key="AddButtonBorderBrush" Color="#9FC6C0"/>

    <SolidColorBrush x:Key="WorkButtonBackgroundBrush" Color="#D7EAF7"/>
    <SolidColorBrush x:Key="WorkButtonBorderBrush" Color="#BDD9EC"/>

    <SolidColorBrush x:Key="CrazyButtonBackgroundBrush" Color="#F5D6E4"/>
    <SolidColorBrush x:Key="CrazyButtonBorderBrush" Color="#E8BFD1"/>

    <SolidColorBrush x:Key="RestoreButtonBackgroundBrush" Color="#E3F3E6"/>
    <SolidColorBrush x:Key="RestoreButtonBorderBrush" Color="#B8D8BE"/>
    <SolidColorBrush x:Key="RestoreButtonTextBrush" Color="#3F6F48"/>

    <SolidColorBrush x:Key="AbilityButtonBackgroundBrush" Color="#F0ECF8"/>
    <SolidColorBrush x:Key="AbilityButtonBorderBrush" Color="#D7CFEA"/>

    <SolidColorBrush x:Key="RemoveButtonBackgroundBrush" Color="#FBE0DE"/>
    <SolidColorBrush x:Key="RemoveButtonBorderBrush" Color="#F0C3BF"/>
    <SolidColorBrush x:Key="RemoveButtonTextBrush" Color="#A94F49"/>


    <!-- ========================================================= -->
    <!-- GROUP FILTERS                                             -->
    <!-- ========================================================= -->
    <SolidColorBrush x:Key="GroupFilterBackgroundBrush" Color="#EFFFFFFF"/>
    <SolidColorBrush x:Key="GroupFilterBorderBrush" Color="#D7E3EB"/>
    <SolidColorBrush x:Key="GroupFilterHoverBrush" Color="#E5F1F8"/>
    <SolidColorBrush x:Key="GroupFilterSelectedBrush" Color="#CFE5F3"/>
    <SolidColorBrush x:Key="GroupFilterSelectedBorderBrush" Color="#8AB8D4"/>


    <!-- ========================================================= -->
    <!-- PAGE HEADERS                                              -->
    <!-- ========================================================= -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Margin" Value="1,4,0,0"/>
    </Style>

    <Thickness x:Key="PageContentMargin">28</Thickness>
    <Thickness x:Key="PageHeaderMargin">0,0,0,20</Thickness>


    <!-- ========================================================= -->
    <!-- COMMON SIZES                                              -->
    <!-- ========================================================= -->
    <CornerRadius x:Key="SmallCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="MainCornerRadius">14</CornerRadius>

    <Thickness x:Key="CardPadding">20</Thickness>

</ResourceDictionary>